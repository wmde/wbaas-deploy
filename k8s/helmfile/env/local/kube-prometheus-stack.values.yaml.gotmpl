grafana:
  enabled: true
  ingress:
    enabled: true
    hosts:
      - grafana.wbaas.dev
    paths:
      - path: /
        pathType: Prefix
    annotations:
      kubernetes.io/ingress.class: nginx

prometheus:
  prometheusSpec:
    resources:
      requests:
        cpu: "200m"
        memory: "1Gi"
      limits:
        memory: "2Gi"
    image:
      registry: quay.io
      repository: prometheus/prometheus
      tag: v2.49.1

  ingress:
    enabled: true
    hosts:
      - prometheus.wbaas.dev
    paths:
      - /
    annotations:
      kubernetes.io/ingress.class: nginx
